rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function teacher() { return signed() && (request.auth.uid == '1joQiJlWSDOhNX5bFVYD66b7iF72' || request.auth.token.teacher == true); }
  function owner(uid) { return signed() && request.auth.uid == uid; }
  function studentScope() { return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.scope; }
  match /gradeInvites/{id} { allow read,write: if teacher(); }
  match /enrollmentLocks/{id} { allow read,write: if teacher(); }
  match /enrollmentRequests/{uid} {
   allow get: if owner(uid) || teacher();
   allow list: if teacher();
   allow create: if owner(uid) && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider in ['google.com','password']
     && request.resource.data.keys().hasOnly(['carnet','email','status','createdAt'])
     && request.resource.data.carnet is string && request.resource.data.carnet.size() > 0 && request.resource.data.carnet.size() <= 80
     && request.resource.data.email == request.auth.token.email && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update,delete: if teacher();
  }
  match /students/{uid} { allow read: if teacher() || owner(uid); allow write: if teacher(); }
  match /sessions/{id} {
   allow get: if signed(); allow list: if teacher(); allow write: if teacher();
  }
  match /attendance/{id} {
   allow get: if teacher() || (signed() && (resource.data.studentUid == request.auth.uid || (!exists(/databases/$(database)/documents/attendance/$(id)) && id.matches('^[A-Za-z0-9_-]+_' + request.auth.uid + '$'))));
   allow list: if teacher() || (signed() && resource.data.studentUid == request.auth.uid);
   allow create: if teacher() || (signed()
     && id.matches('^[A-Za-z0-9_-]+_[A-Za-z0-9_-]+$')
     && request.resource.data.studentUid == request.auth.uid
     && request.resource.data.keys().hasOnly(['studentUid','carnet','scope','sessionId','date','title','status','time','createdAt'])
     && request.resource.data.sessionId is string
     && id == request.resource.data.sessionId + '_' + request.auth.uid
     && exists(/databases/$(database)/documents/students/$(request.auth.uid))
     && request.resource.data.carnet == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.carnet
     && request.resource.data.scope == studentScope()
     && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
     && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.scope == studentScope()
     && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'open'
     && request.time >= get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.startsAt
     && request.time <= get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.endsAt
     && request.resource.data.date == get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.date
     && request.resource.data.title == get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.title
     && request.resource.data.status in ['Presente','Tarde']
     && request.resource.data.createdAt == request.time
     && request.resource.data.time == request.time
     && ((request.time <= get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.tardyAt && request.resource.data.status == 'Presente')
      || (request.time > get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.tardyAt && request.resource.data.status == 'Tarde')));
   allow update,delete: if teacher();
  }
  match /grades/{id} { allow read: if teacher() || (signed() && resource.data.studentUid == request.auth.uid); allow write: if teacher(); }
  match /justifications/{id} {
   allow read: if teacher() || (signed() && resource.data.studentUid == request.auth.uid);
   allow create: if signed() && request.resource.data.studentUid == request.auth.uid
     && request.resource.data.keys().hasOnly(['studentUid','attendanceId','cause','reason','status','createdAt'])
     && request.resource.data.cause == 'estudiante'
     && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 1000
     && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
     && exists(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId))
     && get(/databases/$(database)/documents/attendance/$(request.resource.data.attendanceId)).data.studentUid == request.auth.uid;
   allow update,delete: if teacher();
  }
  match /instrumentos/{id} { allow read,write: if teacher(); }
  match /studentProfiles/{uid} {
   allow read: if teacher() || owner(uid);
   allow create,update: if owner(uid) && exists(/databases/$(database)/documents/students/$(uid)) && request.resource.data.keys().hasOnly(['name','career','year','group','subject','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 150 && request.resource.data.career is string && request.resource.data.career.size() <= 100 && request.resource.data.year is string && request.resource.data.year.size() <= 30 && request.resource.data.group is string && request.resource.data.group.size() <= 30 && request.resource.data.subject in ['A1','A2','A2+'] && request.resource.data.updatedAt == request.time;
  }
  match /learningEvidence/{id} {
   allow read: if teacher() || (signed() && resource.data.studentUid == request.auth.uid);
   allow create: if signed() && request.resource.data.studentUid == request.auth.uid && request.resource.data.scope == studentScope() && request.resource.data.keys().hasOnly(['studentUid','scope','title','partial','url','description','status','createdAt']) && request.resource.data.title is string && request.resource.data.title.size() <= 150 && request.resource.data.partial in ['I','II','III'] && request.resource.data.url is string && request.resource.data.url.size() <= 1000 && request.resource.data.url.matches('https://.*') && request.resource.data.description is string && request.resource.data.description.size() <= 1000 && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
   allow update,delete: if teacher();
  }
  match /audit/{id} { allow read,write: if teacher(); }
  match /{document=**} { allow read,write: if false; }
 }
}
